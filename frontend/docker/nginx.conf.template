# nginx in the frontend image (frontend/Dockerfile, #334). The entrypoint fills ${API_UPSTREAM}
# and ${NGINX_LOCAL_RESOLVERS}; every other $name is nginx's own.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Redirects nginx makes itself (none expected) keep the browser's host and port.
    absolute_redirect off;
    server_tokens off;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # The API's BrowserGate (docs/OPERATIONS.md §1.1) judges the Host and Origin the browser
    # sent: Host goes through with its port ($http_host; $host drops the port), and Origin,
    # Sec-Fetch-Site and Content-Type pass untouched, as nginx forwards request headers by
    # default. The api admits that Host through STOCK_API_PUBLIC_HOSTS (#343, #335).
    location /api/ {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }

    # Hashed build files; a missing one is a 404, not the page.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Single-page app: every other path is index.html, which is never cached so a new
    # build is picked up on reload.
    location / {
        try_files $uri /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
