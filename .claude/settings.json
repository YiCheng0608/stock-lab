{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/ops/compact_hook.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ops/turn_hook.cjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ops/turn_hook.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ops/turn_hook.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ops/turn_hook.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell|Read|Grep|Glob|NotebookEdit|Monitor|Artifact|ArtifactData|DesignSync|mcp__codebase-memory-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tools/ops/agent_guard.cjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "financial-analysis@claude-for-financial-services": false,
    "pitch-agent@claude-for-financial-services": false,
    "gl-reconciler@claude-for-financial-services": false,
    "market-researcher@claude-for-financial-services": false
  },
  "disableClaudeAiConnectors": true,
  "enableArtifact": false,
  "permissions": {
    "deny": [
      "SendFeedback"
    ]
  },
  "skillOverrides": {
    "dataviz": "off",
    "artifact-design": "off",
    "artifact-diagramming": "off",
    "artifact-capabilities": "off",
    "claude-in-chrome": "off",
    "schedule": "off",
    "run": "off",
    "plugin-authoring": "off",
    "keybindings-help": "off",
    "claude-api": "off",
    "fewer-permission-prompts": "off",
    "find-skills": "off",
    "init": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:deep-research": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:import-memory": "off"
  }
}
