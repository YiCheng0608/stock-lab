# Optional overrides for local development.
# STOCK_DB_PATH=C:/absolute/path/to/data/stock.db
# STOCK_DATA_DIR=C:/absolute/path/to/data
# STOCK_RAW_DIR=C:/absolute/path/to/data/raw
# VITE_API_BASE=http://127.0.0.1:8000/api
# Extra Host / Origin values the API's write gate admits (docs/OPERATIONS.md section 1.1); comma-separated, loopback names only.
# STOCK_API_PUBLIC_HOSTS=localhost:8080
# STOCK_API_ALLOWED_ORIGINS=http://localhost:5174
# Docker compose (docs/OPERATIONS.md section 1.2): host ports, never 80; WEB_PORT never 8000; empty means the
# default. Compose fixes TZ and the three STOCK_* paths in the containers itself (and STOCK_API_PUBLIC_HOSTS,
# VITE_API_BASE, the dev override's STOCK_API_ALLOWED_ORIGINS), so those values in the env file have no effect there.
# WEB_PORT=8080
# API_PORT=8000
